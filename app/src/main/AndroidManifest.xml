<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentVotingApp">

        <!-- Splash / Welcome Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.StudentVotingApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Main Menu -->
        <activity
            android:name=".MainMenuActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Candidates -->
        <activity
            android:name=".candidates.CandidatesMenuActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".candidates.CandidateListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".candidates.CandidateDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".candidates.CandidateUpdateActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Students -->
        <activity
            android:name=".students.StudentsMenuActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".students.StudentListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".students.StudentVoteActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".students.StudentResultsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".students.StudentStatusActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Admin -->
        <activity
            android:name=".admin.AdminMenuActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".admin.AdminTrackActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".admin.AdminReportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".admin.AdminModifyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".admin.AdminAnnounceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
